COOKIE_SECRET=
SESSION_SECRET=
CSRF_SECRET=

CSRF_COOKIE_NAME=csrfToken
CSRF_TOKEN_HEADER=X-CSRF-Token
ENABLE_HTTPS_REDIRECT=false
TRUST_PROXY=true
HELMET_ENABLED=true
BCRYPT_SALT_ROUNDS=12

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
HOTEL_NOTIFICATION_EMAIL=
HOTEL_EMAIL=

CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=

AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
