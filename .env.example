# Hatsey Kaleb Hotel - Environment Template
# Copy this file to .env and replace placeholders with your real local or deployment values.
# This file is safe to commit because it contains no secrets.

# ============================================================
# Application
# ============================================================
NODE_ENV=development
PORT=3000
APP_NAME="Hatsey Kaleb Hotel"
APP_URL="http://localhost:3000"

# ============================================================
# Frontend / API
# ============================================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:3000
BACKEND_URL="http://localhost:3000"

# ============================================================
# AI Concierge (server-side only)
# ============================================================
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=

# ============================================================
# Database (Prisma / PostgreSQL)
# ============================================================
DATABASE_URL=
DIRECT_URL=

# ============================================================
# Authentication / Security
# ============================================================
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=
SESSION_SECRET=
CSRF_SECRET=
COOKIE_SAME_SITE="strict"
CSRF_COOKIE_NAME=csrfToken
CSRF_TOKEN_HEADER=X-CSRF-Token
ENABLE_HTTPS_REDIRECT=false
HTTPS_KEY_PATH="./certs/server.key"
HTTPS_CERT_PATH="./certs/server.crt"
TRUST_PROXY=true
HELMET_ENABLED=true
BCRYPT_SALT_ROUNDS=12

# ============================================================
# Email (SMTP)
# ============================================================
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
HOTEL_NOTIFICATION_EMAIL=
HOTEL_EMAIL=

# ============================================================
# Chapa
# ============================================================
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=

# ============================================================
# Stripe
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY="usd"
VITE_STRIPE_PUBLIC_KEY=

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================
# Analytics / Frontend Runtime
# ============================================================
VITE_GA_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_CLARITY_PROJECT_ID=
VITE_GOOGLE_ANALYTICS_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_DEPLOYMENT_ENV=development

# ============================================================
# Logging / Monitoring
# ============================================================
LOG_LEVEL=debug
LOG_FILE=./logs/app.log
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ============================================================
# Rate Limiting / Security
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# File Uploads
# ============================================================
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ============================================================
# Optional Services
# ============================================================
REDIS_URL=redis://localhost:6379
CACHE_TTL=300

# ============================================================
# Deployment / Test Helpers
# ============================================================
BASE_URL=http://localhost:3000
TEST_BASE_URL=http://localhost:3000
PLAYWRIGHT_BASE_URL=http://localhost:3000
SKIP_SERVER_START=false
