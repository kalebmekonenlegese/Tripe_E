NODE_ENV=development
PORT=3000

FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:3000

DATABASE_URL=
DIRECT_URL=

JWT_SECRET=
